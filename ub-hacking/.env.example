PORT=3001
# Optional: path to a native Stockfish executable. Bundled WASM engine is the default.
# STOCKFISH_PATH=C:\engines\stockfish.exe
ANALYSIS_MS=300
# Gemini API key for post-game recaps based on Stockfish evaluations.
# GEMINI_API_KEY=your-key-here
# Optional, comma-separated allowed browser origins. Same-origin is the default.
# ALLOWED_ORIGINS=https://your-domain.example
